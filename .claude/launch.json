{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "phoenix-v2",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 3100,
      "autoPort": true
    },
    {
      "name": "phoenix-static",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "serve",
        "out",
        "-l",
        "4321"
      ],
      "port": 4321
    },
    {
      "name": "plugin-harness",
      "runtimeExecutable": "C:/xampp/php/php.exe",
      "runtimeArgs": [
        "-S",
        "127.0.0.1:4330",
        "-t",
        "wp-plugin",
        "wp-plugin/tests/harness/router.php"
      ],
      "port": 4330
    }
  ]
}
