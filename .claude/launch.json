{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "phoenix-v2",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 3100,
      "autoPort": true
    },
    {
      "name": "phoenix-static",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "serve",
        "out",
        "-l",
        "4321"
      ],
      "port": 4321
    },
    {
      "name": "plugin-harness",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "-m",
        "http.server",
        "4330",
        "--bind",
        "127.0.0.1",
        "--directory",
        "wp-plugin"
      ],
      "port": 4330
    }
  ]
}
