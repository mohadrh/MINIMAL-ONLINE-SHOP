# ============================================================
#  فونیکس شاپ — متغیرهای محیطی
#
#  این فایل نمونه است و در گیت می‌ماند.
#  مقدارهای واقعی را در .env.local بگذار که در .gitignore است.
# ============================================================

# ---------- ووکامرس ----------
# آدرس وردپرس، بدون اسلش آخر
WORDPRESS_URL=https://shop.example.com

# ⚠ این دو راز هستند و هرگز نباید NEXT_PUBLIC_ شوند.
#   از پیشخوان ووکامرس ساخته می‌شوند:
#   ووکامرس ← تنظیمات ← پیشرفته ← REST API ← افزودن کلید
#   دسترسی: برای همگام‌سازی «خواندن» کافی است.
#   برای ثبت سفارش از سمت سرور «خواندن/نوشتن» لازم است.
WOO_CONSUMER_KEY=
WOO_CONSUMER_SECRET=

# ---------- پل عمومی ----------
# اگر سایت روی میزبان ایستا است و سرور ندارد، به‌جای کلید بالا
# می‌توان از اندپوینت عمومی افزونه استفاده کرد. این یکی راز نیست.
NEXT_PUBLIC_BRIDGE_URL=

# ---------- تنظیم‌های ریز ----------
WOO_TIMEOUT_MS=15000
REVALIDATE_CATALOG=600
REVALIDATE_STOCK=60

# ---------- بیلد ایستا برای GitHub Pages ----------
STATIC_EXPORT=1
NEXT_PUBLIC_BASE_PATH=/MINIMAL-ONLINE-SHOP
